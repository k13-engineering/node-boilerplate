{
  "type": "module",
  "main": "lib/index.ts",
  "scripts": {
    "build": "rm -rf dist/ && deno-node-build --root . --out dist/ --entry lib/index.ts",
    "type-check": "tsc --noEmit",
    "test": "c8 --100 --reporter lcov --reporter html --reporter text --all --src lib/ --exclude lib/snippets/ --exclude 'lib/**/*.spec.ts' mocha 'lib/**/*.spec.ts'",
    "lint": "eslint .",
    "update-deps": "npm-check-updates -u",
    "update-template-deps": "npm-check-updates --packageFile package.template.json -u"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@k13engineering/eslint-rules": "^0.0.6",
    "@k13engineering/releasetool": "^0.0.6",
    "@types/deep-equal": "^1.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "c8": "^12.0.0",
    "deno-node": "^0.0.12",
    "mocha": "^12.0.3",
    "npm-check-updates": "^23.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "deep-equal": "^2.2.3",
    "esm-resource": "^0.0.3"
  }
}
